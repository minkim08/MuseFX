# Export these variables before cargo run; .env files are not loaded automatically.
BIND_ADDR=127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000
RUST_LOG=video_to_sfx=info,tower_http=info
# DATA_DIR=/absolute/path/to/jobs
# Real Audio (unset = Mock Audio test tone). AUDIO_FAKE=1 uses synthetic sounds with no GPU.
# AUDIO_DIR=../../audio
# AUDIO_FAKE=1
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=
