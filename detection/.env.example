# Copy to .env and fill in. Never commit .env.
# Export these before running the Detection service; .env is not loaded automatically yet.
# API reference: https://dev.meta.ai/docs/overview

# Meta Model API (required for real Detection; leave empty to run offline with fixtures)
# Official name per https://dev.meta.ai/docs/authentication — Authorization header at https://api.meta.ai/v1
MODEL_API_KEY=
# Set only if the Meta portal gives you a different base URL or model IDs (confirm in Phase 0)
# META_MODEL_BASE_URL=https://api.meta.ai/v1
# MUSE_SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=

# Detection service (this component's own API)
DETECTION_HOST=127.0.0.1
DETECTION_PORT=8100
